{
  "name": "veyra-ai",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node --watch src/backend/index.js",
    "start:backend": "node src/backend/index.js",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/audit.test.ts tests/i18n.test.ts tests/review-queue.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "test:backend": "node --no-experimental-strip-types --test tests/backend-runtime.test.js"
  },
  "keywords": [
    "invoice-auditing",
    "expense-tracking",
    "ai",
    "finance",
    "automation"
  ],
  "author": "Veyra AI",
  "license": "MIT",
  "description": "Veyra AI \u2014 Invoice & Expense Auditing Platform with automated extraction, anomaly detection, and spend intelligence.",
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@clerk/express": "^2.1.88",
    "@clerk/localizations": "^4.24.6",
    "@clerk/react": "^6.18.6",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "framer-motion": "^14.10.1",
    "lucide-react": "^1.70.0",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": "24.x"
  }
}
